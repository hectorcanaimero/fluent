# Variables de entorno de la API y el worker (SPEC-08 §2).
# Copiar a .env y rellenar con valores reales. No commitear .env.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# URL base del proyecto InsForge
INSFORGE_URL=changeme

# API key de InsForge (admin; solo backend, nunca al cliente)
INSFORGE_API_KEY=changeme

# Anon key de InsForge (para llamadas con token de usuario si hicieran falta)
INSFORGE_ANON_KEY=changeme

# URL de conexión a Redis
REDIS_URL=changeme

# 9router: URL base OpenAI-compatible y API key del operador
NINEROUTER_URL=changeme
NINEROUTER_API_KEY=changeme

# Modelos de fallback, como JSON serializado (opcional; SPEC-03 §2)
FALLBACK_MODELS=

# Versión del prompt en uso
PROMPT_VERSION=1

# UUID del usuario operador/owner
OWNER_USER_ID=changeme

# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent
# Tope de turnos por día natural del usuario según su plan (MAL-23). 0 lo desactiva.
TURNS_DAILY_CAP_FREE=30
TURNS_DAILY_CAP_PRO=120

LOG_LEVEL=info

# Cuenta de servicio de Firebase (JSON en base64) para enviar push. Vacío = push desactivado.
FIREBASE_SERVICE_ACCOUNT=
